<% 
const formatNumber = (num) => {
  return new Intl.NumberFormat('th-TH', { 
    minimumFractionDigits: 2,
    maximumFractionDigits: 2 
  }).format(num);
};

const formatDate = (dateStr) => {
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat('th-TH', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(date);
};

// Simple relative time helper
const timeAgo = (dateStr) => {
  const date = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now - date) / 1000);
  
  if (diffInSeconds < 60) return 'เมื่อสักครู่';
  if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)} นาทีที่แล้ว`;
  if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)} ชั่วโมงที่แล้ว`;
  return formatDate(dateStr);
};
%>

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Expense Tracker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    /* Hide scrollbar for clean look */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-cream-50 text-gray-800 antialiased min-h-screen">
  
  <div class="max-w-7xl mx-auto px-6">
    <!-- Navbar Organism -->
    <%- include('components/organisms/navbar', { path: '/' }) %>

    <!-- Welcome Section -->
    <header class="mb-8">
      <h1 class="text-4xl font-light text-cream-900 mb-2">Welcome back, <span class="font-bold">User</span></h1>
      <p class="text-gray-500">ติดตามค่าใช้จ่ายของคุณได้ง่ายๆ ที่นี่</p>
    </header>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      
      <!-- Primary Stat Card (Total) -->
      <div class="col-span-1 md:col-span-2 bg-cream-900 rounded-3xl p-8 text-white relative overflow-hidden shadow-lg group">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:scale-110 transition-transform duration-700"></div>
        
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <div class="text-white/60 mb-1 font-medium">ยอดรวมรายจ่ายทั้งหมด</div>
            <div class="text-5xl font-bold tracking-tight mb-4">฿<%= formatNumber(total) %></div>
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-sm font-medium">
              <span class="w-2 h-2 rounded-full bg-accent-yellow"></span>
              <span>Updated just now</span>
            </div>
          </div>
          
          <div class="mt-8">
            <%- include('components/atoms/button', { label: 'เพิ่มรายจ่ายใหม่', type: 'primary', href: '/add', icon: '+', className: 'w-full md:w-auto shadow-lg shadow-accent-yellow/20' }) %>
          </div>
        </div>
      </div>

      <!-- Quick Stats -->
      <%- include('components/molecules/stat-card', { 
        label: 'จำนวนรายการทั้งหมด', 
        value: expenses.length, 
        icon: '📝' 
      }) %>

      <%- include('components/molecules/stat-card', { 
        label: 'หมวดหมู่ที่มีการใช้จ่าย', 
        value: categories.length, 
        icon: '🏷️' 
      }) %>

    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pb-12">
      
      <!-- Left Column: Filters & Analysis -->
      <div class="space-y-6">
        
        <!-- Filter Card -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-cream-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
            ตัวกรอง
          </h3>
          
          <form action="/filter" method="GET" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">หมวดหมู่</label>
              <div class="flex flex-wrap gap-2">
                <% categories.forEach(category => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="category" value="<%= category.name %>" class="peer sr-only" <%= filter.category === category.name ? 'checked' : '' %>>
                    <span class="inline-block px-3 py-1.5 rounded-xl text-sm border border-gray-200 text-gray-600 peer-checked:bg-cream-900 peer-checked:text-white peer-checked:border-cream-900 transition-all hover:bg-gray-50">
                      <%= category.name %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">วันที่</label>
              <div class="space-y-2">
                <input type="date" name="start" value="<%= filter.start || '' %>" class="w-full bg-gray-50 border-none rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-cream-900 placeholder-gray-400">
                <input type="date" name="end" value="<%= filter.end || '' %>" class="w-full bg-gray-50 border-none rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-cream-900 placeholder-gray-400">
              </div>
            </div>

            <div class="pt-2 flex gap-2">
               <%- include('components/atoms/button', { label: 'ค้นหา', submit: true, type: 'dark', className: 'w-full py-2 text-sm' }) %>
               <a href="/" class="px-4 py-2 rounded-full border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm flex items-center justify-center">Reset</a>
            </div>
          </form>
        </div>

        <!-- Ad/Promo/Mini Chart Placeholder -->
        <div class="bg-accent-yellow/20 p-6 rounded-3xl border border-accent-yellow/30 relative overflow-hidden">
             <div class="absolute -right-6 -bottom-6 text-9xl opacity-20 rotate-12">💰</div>
             <div class="relative z-10">
                <h4 class="font-bold text-cream-900 mb-2">Tip of the day</h4>
                <p class="text-sm text-cream-900/80 leading-relaxed">การบันทึกรายจ่ายเป็นประจำ ช่วยให้คุณวางแผนการเงินได้ดีขึ้น 30%</p>
             </div>
        </div>

      </div>

      <!-- Right Column: Transactions List -->
      <div class="col-span-1 lg:col-span-2">
        <div class="bg-white rounded-[2rem] shadow-sm border border-gray-100 p-6 md:p-8">
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-bold text-cream-900">ประวัติการใช้จ่าย</h2>
              <div class="text-sm text-gray-400"><%= expenses.length %> รายการ</div>
            </div>

            <% if (expenses.length > 0) { %>
              <div class="space-y-4">
                <% expenses.forEach(expense => { %>
                  <!-- Transaction Item Molecule -->
                  <div class="group flex flex-col md:flex-row md:items-center justify-between p-5 rounded-2xl hover:bg-cream-50 border border-gray-100 hover:border-cream-200 transition-all duration-200">
                      
                      <!-- Info -->
                      <div class="flex items-start gap-4 mb-4 md:mb-0">
                        <div class="w-12 h-12 rounded-2xl bg-cream-100 flex items-center justify-center text-xl shrink-0 text-cream-900">
                          <%# Simple emoji mapping based on categories could go here, randomized for now %>
                          🧾
                        </div>
                        <div>
                          <h3 class="font-bold text-gray-900 text-lg"><%= expense.description %></h3>
                          <div class="flex items-center gap-2 text-sm text-gray-500 mt-1">
                            <span class="px-2 py-0.5 rounded-lg bg-gray-100 text-xs font-medium"><%= expense.category %></span>
                            <span>•</span>
                            <span><%= formatDate(expense.date) %></span>
                          </div>
                        </div>
                      </div>

                      <!-- Amount & Actions -->
                      <div class="flex items-center justify-between md:justify-end gap-6 w-full md:w-auto">
                        <div class="text-right">
                           <div class="font-bold text-xl text-cream-900">-฿<%= formatNumber(expense.amount) %></div>
                           <div class="text-xs text-gray-400"><%= timeAgo(expense.date) %></div>
                        </div>
                        
                        <!-- Hover Actions -->
                        <div class="flex gap-2 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                          <form action="/expenses/edit/<%= expense.id %>" method="POST" style="display:inline;">
                             <button type="submit" class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-200 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                             </button>
                          </form>
                          <form action="/expenses/delete" method="POST" onsubmit="return confirm('ยืนยันการลบรายการนี้?');" style="display:inline;">
                            <input type="hidden" name="id" value="<%= expense.id %>">
                            <button type="submit" class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-red-600 hover:border-red-200 transition-colors">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                          </form>
                        </div>
                      </div>

                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="text-center py-20 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200">
                <div class="text-4xl mb-4">📭</div>
                <h3 class="text-gray-900 font-medium mb-1">ยังไม่มีรายการ</h3>
                <p class="text-gray-500 mb-6">เริ่มต้นบันทึกรายจ่ายแรกของคุณวันนี้</p>
                <%- include('components/atoms/button', { label: 'เพิ่มรายจ่าย', type: 'primary', href: '/add', icon: '+' }) %>
              </div>
            <% } %>

            <!-- Pagination/View All (Placeholder) -->
            <% if (expenses.length > 5) { %>
              <div class="mt-8 text-center border-t border-gray-100 pt-6">
                <button class="text-cream-900 font-medium hover:text-gray-600 transition-colors text-sm">ดูรายการทั้งหมด ➝</button>
              </div>
            <% } %>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
