<% 
const formatNumber = (num) => {
  return new Intl.NumberFormat('th-TH', { 
    minimumFractionDigits: 2,
    maximumFractionDigits: 2 
  }).format(num);
};

const formatDate = (dateStr) => {
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat('th-TH', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};
%>

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Expense Tracker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-cream-50 text-gray-800 antialiased min-h-screen font-sans">
  
  <div class="max-w-7xl mx-auto px-6 pb-12">
    <%- include('components/organisms/navbar', { path: '/summary' }) %>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-cream-900 mb-2">สรุปรายงาน</h1>
            <p class="text-gray-500">วิเคราะห์พฤติกรรมการใช้จ่ายของคุณ</p>
        </div>
        
        <!-- Period Tabs -->
        <div class="bg-white p-1 rounded-2xl border border-gray-200 inline-flex shadow-sm">
            <% const tabs = [
                { id: 'today', label: 'วันนี้' }, 
                { id: 'week', label: 'สัปดาห์นี้' }, 
                { id: 'month', label: 'เดือนนี้' }
            ]; %>
            
            <% tabs.forEach(tab => { %>
                <a href="/summary?period=<%= tab.id %>" 
                   class="px-5 py-2 rounded-xl text-sm font-medium transition-all <%= period === tab.id ? 'bg-cream-900 text-white shadow-md' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50' %>">
                   <%= tab.label %>
                </a>
            <% }) %>
        </div>
    </div>

    <!-- Date Range & Filters Row -->
    <div class="mb-8 bg-white p-4 rounded-3xl border border-gray-100 shadow-sm">
        <form action="/summary" method="GET" class="flex flex-col md:flex-row items-center gap-4 w-full">
            <div class="flex-1 w-full md:w-auto flex items-center gap-2 text-sm text-gray-500 px-4">
                 <span class="w-2 h-2 rounded-full bg-accent-yellow"></span>
                 ช่วงเวลา: <span class="font-medium text-gray-900"><%= formatDate(startDate) %></span> ถึง <span class="font-medium text-gray-900"><%= formatDate(endDate) %></span>
            </div>
            
            <div class="flex gap-2 w-full md:w-auto">
                <input type="date" name="startDate" value="<%= startDate %>" class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-cream-900 outline-none">
                <input type="date" name="endDate" value="<%= endDate %>" class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-cream-900 outline-none">
                <button type="submit" class="bg-cream-900 text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-gray-800 transition-colors">
                    กรองกำหนดเอง
                </button>
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Total Summary Card -->
        <div class="col-span-1 lg:col-span-3 bg-cream-900 text-white rounded-[2.5rem] p-10 relative overflow-hidden shadow-xl">
            <div class="absolute top-0 right-0 w-96 h-96 bg-accent-yellow/10 rounded-full translate-x-1/3 -translate-y-1/3 blur-3xl"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div>
                    <div class="text-white/60 font-medium mb-2 text-lg">ยอดรวมรายจ่ายทั้งหมด</div>
                    <div class="text-6xl font-bold tracking-tight mb-4">฿<%= formatNumber(totalExpenses) %></div>
                    <div class="text-white/40 text-sm">ในช่วงเวลาที่เลือก</div>
                </div>
                
                <!-- Simple Donut Chart Representation for visual interest -->
                <div class="flex items-center gap-8">
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 min-w-[200px]">
                         <div class="text-3xl font-bold mb-1"><%= categorySummary.length %></div>
                         <div class="text-white/60 text-sm">หมวดหมู่</div>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 min-w-[200px]">
                        <div class="text-3xl font-bold mb-1"><%= Math.round(totalExpenses / (categorySummary.length || 1)).toLocaleString() %></div>
                         <div class="text-white/60 text-sm">เฉลี่ยต่อหมวด</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Category Breakdown -->
        <div class="col-span-1 lg:col-span-2 bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
             <h3 class="text-xl font-bold text-cream-900 mb-6 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-cream-100 flex items-center justify-center text-sm">📊</span>
                แยกตามหมวดหมู่
             </h3>

             <div class="space-y-4">
                <% if (categorySummary.length > 0) { %>
                    <% categorySummary.forEach(item => { 
                        const percentage = ((item.total / totalExpenses) * 100).toFixed(1);
                    %>
                        <div class="group">
                            <div class="flex items-end justify-between mb-2">
                                <span class="font-medium text-gray-700"><%= item.category %></span>
                                <div class="text-right">
                                    <span class="font-bold text-cream-900">฿<%= formatNumber(item.total) %></span>
                                    <span class="text-xs text-gray-400 ml-1">(<%= percentage %>%)</span>
                                </div>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                                <div class="bg-cream-900 h-2.5 rounded-full transition-all duration-500 ease-out group-hover:bg-accent-yellow" style="width: <%= percentage %>%"></div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-12 text-gray-400">
                        ไม่มีข้อมูลรายจ่ายในช่วงเวลานี้
                    </div>
                <% } %>
             </div>
        </div>

        <!-- Chart Placeholder / Insight -->
        <div class="col-span-1 bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100 flex flex-col justify-center text-center relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
            
            <div class="relative z-10">
                <div class="w-20 h-20 bg-accent-yellow rounded-full flex items-center justify-center text-4xl mx-auto mb-6 text-cream-900 shadow-lg shadow-accent-yellow/30">
                    💡
                </div>
                <h3 class="text-xl font-bold text-cream-900 mb-2">Insight</h3>
                <p class="text-gray-500 leading-relaxed mb-6">
                    หมวดหมู่ที่คุณใช้จ่ายมากที่สุดคือ 
                    <span class="font-bold text-cream-900"><%= categorySummary.length > 0 ? categorySummary[0].category : '-' %></span>
                    คิดเป็น <%= categorySummary.length > 0 ? ((categorySummary[0].total / totalExpenses) * 100).toFixed(0) : 0 %>% ของยอดรวมทั้งหมด
                </p>
                
                <a href="/" class="inline-block text-cream-900 font-medium border-b border-cream-900 pb-0.5 hover:opacity-70 transition-opacity">
                    ดูรายการทั้งหมด
                </a>
            </div>
        </div>

    </div>
  </div>

</body>
</html>
